{
  "name": "oneapichat-client",
  "version": "4.0.0",
  "description": "OneAPIChat 桌面客户端 — 瘦客户端模式，连接远程服务器",
  "main": "electron_main.js",
  "homepage": "https://github.com/chickenyoutoo-beautiful/oneapichat",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "build:mac": "electron-builder --mac --x64",
    "build:all": "electron-builder --win --linux --mac --x64",
    "build:android": "bash build-android.sh",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.oneapichat.client",
    "productName": "OneAPIChat",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "chickenyoutoo-beautiful",
      "repo": "oneapichat",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../public/resource/icon-512.png",
      "artifactName": "OneAPIChat-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneAPIChat",
      "installerIcon": "../public/resource/icon-256.ico",
      "uninstallerIcon": "../public/resource/icon-256.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "../public/resource/icon-512.png",
      "artifactName": "OneAPIChat-${version}-linux-x64.${ext}",
      "maintainer": "chickenyoutoo-beautiful <xyq070519@gmail.com>",
      "category": "Network"
    },
    "mac": {
      "target": "dmg",
      "icon": "../public/resource/icon-512.png",
      "artifactName": "OneAPIChat-${version}-mac-x64.${ext}"
    }
  },
  "keywords": [
    "chat",
    "ai",
    "oneapi",
    "desktop",
    "electron"
  ],
  "author": {
    "name": "chickenyoutoo-beautiful",
    "email": "xyq070519@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
