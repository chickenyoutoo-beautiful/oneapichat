# ==============================================================================
# OneAPIChat Docker 部署环境变量配置
# 复制为 .env 即可生效: cp .env.example .env
# ==============================================================================

# 外部映射端口 (默认 8080)
PORT=8080

# 绑定自定义域名 (例: chat.example.com；若留空则自动通配支持 IP、localhost 与任意来源)
DOMAIN=

# 是否使用 HTTPS/SSL (若前置反向代理配置了 SSL 证书，请设为 true)
SSL_ENABLED=false

# AES-256 加密密钥 (32 位随机字符；若留空，容器首次启动将自动生成并持久化)
ENCRYPTION_KEY=

# Cloudreve 云盘外部完整访问 URL (例如 https://pan.example.com 或 http://IP:8080/cloudreve)
CLOUDREVE_SITE_URL=

# Cloudreve 独立直连端口 (默认 5212)
CLOUDREVE_PORT=5212

# CPA (CLIProxyAPI) 代理管理密钥
CPA_API_KEY=cpa-oneapichat-secret-key

# CPA 独立直连端口 (默认 8317)
CPA_PORT=8317

# 子服务可选启用开关
ENABLE_CLOUDREVE=true
ENABLE_CPA=true
